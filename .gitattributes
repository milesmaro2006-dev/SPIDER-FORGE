# ============================================================
# SpiderForge — .gitattributes
# يحمي line endings لما تنسخ من Kali → Windows
# ============================================================

# ----- Default behavior -----
# اكتشف النوع تلقائيًا، ولا تحوّل أي حاجة
* text=auto

# ----- Python: LF دايمًا -----
*.py        text eol=lf
*.pyi       text eol=lf

# ----- Shell scripts: LF دايمًا (مهم جدًا!) -----
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf

# ----- PowerShell: CRLF (Windows only) -----
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# ----- Config / data files: LF -----
*.toml      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf

# ----- Windows-only text -----
*.bat       text eol=crlf
*.cmd       text eol=crlf

# ----- Binary: don't touch -----
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.tgz       binary
*.whl       binary
*.db        binary
*.sqlite    binary
*.sqlite3   binary

# ----- Lock files: don't diff (noise) -----
*.lock      -diff
poetry.lock -diff

# ----- Linguist: mark vendored / generated -----
frontend/** linguist-vendored
backend/static/frontend/** linguist-vendored
*.min.js    linguist-vendored
*.min.css   linguist-vendored

# ----- Export ignore: don't ship these in git archive -----
.gitattributes  export-ignore
.gitignore      export-ignore
.github/        export-ignore
tests/          export-ignore
