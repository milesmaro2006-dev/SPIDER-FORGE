# ═══════════════════════════════════════════════════════════════
#  SpiderForge — .gitignore
# ═══════════════════════════════════════════════════════════════

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ─── Virtual environments ───
.venv/
.venv-*/
venv/
env/
ENV/
.python-version

# ─── Build artifacts ───
build/
dist/
*.egg-info/
*.egg
MANIFEST
pip-wheel-metadata/
.eggs/

# ─── Test & coverage caches ───
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ─── SpiderForge runtime ───
.spiderforge/
*.log
server.log
scan_*/
*_workspace/

# ─── Generated reports (only in repo root or explicit dirs) ───
/reports/
/dist/
/out/

# ─── IDE ───
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ─── OS ───
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Distribution ───
dist/
build/
*.whl
*.tar.gz

# ─── Secrets (never commit these) ───
.env
.env.local
secrets.yaml
*.key
*.pem
!examples/*.pem
